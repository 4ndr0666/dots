#!/bin/sh
# setbg — set wallpaper using swaybg (Wayland) with optional pywal theming.
# Wayland migration:
#   xwallpaper → swaybg (already done in original)
#   REMOVED: 'pidof dwm && xdotool key super+F5' — dead under DWL

bgloc="$HOME/Wallpapers/bg"

dunstconf="${XDG_CONFIG_HOME:-$HOME/.config}/dunst/dunstrc"
zathuraconf="${XDG_CONFIG_HOME:-$HOME/.config}/zathura/zathurarc"

while getopts "s" o; do case "${o}" in
    s) silent='1' ;;
esac done
shift $((OPTIND - 1))

trueloc="$(readlink -f "$1")" &&
case "$(file --mime-type -b "$trueloc")" in
    image/* )
        ln -sf "$trueloc" "$bgloc"
        [ -z "$silent" ] && notify-send -i "$bgloc" "Changing wallpaper..." ;;
    inode/directory )
        ln -sf "$(find "$trueloc" -iregex '.*.\(jpg\|jpeg\|png\|gif\)' -type f | shuf -n 1)" "$bgloc"
        [ -z "$silent" ] && notify-send -i "$bgloc" "Random Wallpaper chosen." ;;
    *)
        [ -z "$silent" ] && notify-send "🖼️ Error" "Not a valid image or directory."
        exit 1 ;;
esac

# Optional: pywal theming
if command -v wal >/dev/null 2>&1; then
    wal -n -i "$(readlink -f "$bgloc")" \
        -o "${XDG_CONFIG_HOME:-$HOME/.config}/wal/postrun" >/dev/null 2>&1
else
    [ -f "$dunstconf.bak" ] && unlink "$dunstconf" && mv "$dunstconf.bak" "$dunstconf"
    [ -f "$zathuraconf.bak" ] && unlink "$zathuraconf" && mv "$zathuraconf.bak" "$zathuraconf"
fi

# Set wallpaper via swaybg (Wayland)
swaybg --output '*' --mode fill --image "$bgloc" &
