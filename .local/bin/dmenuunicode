#!/bin/sh
# wl-unicode — Wayland-native emoji/unicode picker
# Replaces dmenuunicode for Wayland sessions.
# Wayland migration:
#   dmenu        → rofi (rofi-lbonn-wayland-git, dual-stack)
#   xdotool type → wtype
#   xclip        → wl-copy

chosen=$(cut -d ';' -f1 ~/.local/share/4ndr0666/chars/* | \
    rofi -dmenu -i -l 30 -p "Unicode:" | sed "s/ .*//")

[ -z "$chosen" ] && exit

if [ -n "$1" ]; then
    wtype "$chosen"
else
    printf "%s" "$chosen" | wl-copy
    notify-send "'$chosen' copied to clipboard." &
fi
