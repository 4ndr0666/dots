#!/bin/sh
# wl-maimpick — Wayland screenshot tool
# Replaces maimpick for Wayland sessions.
# Wayland migration:
#   maim -s (area)         → grim -g "$(slurp)"
#   maim -i window         → grim -g "$(hyprctl activewindow -j | jq -r '.at,.size | map(tostring) | join(",")' | sed 's/,/ /;s/,/x/')"
#   maim (fullscreen)      → grim
#   xclip -sel clip        → wl-copy
#   xdotool getactivewindow → hyprctl activewindow
#   dmenu                  → rofi

output="$(date '+%y%m%d-%H%M-%S').png"
wl_copy_cmd="wl-copy"
ocr_cmd="wl-copy"

case "$(printf "a selected area\\ncurrent window\\nfull screen\\na selected area (copy)\\ncurrent window (copy)\\nfull screen (copy)\\ncopy selected image to text" | \
    rofi -dmenu -l 7 -i -p "Screenshot which area?")" in

    "a selected area")
        grim -g "$(slurp)" "pic-selected-${output}" ;;

    "current window")
        # Get active window geometry from Hyprland IPC
        geom=$(hyprctl activewindow -j | \
            python3 -c "import sys,json; w=json.load(sys.stdin); print('{},{} {}x{}'.format(w['at'][0],w['at'][1],w['size'][0],w['size'][1]))" 2>/dev/null)
        if [ -n "$geom" ]; then
            grim -g "$geom" "pic-window-${output}"
        else
            grim "pic-window-${output}"
        fi ;;

    "full screen")
        grim "pic-full-${output}" ;;

    "a selected area (copy)")
        grim -g "$(slurp)" - | ${wl_copy_cmd} ;;

    "current window (copy)")
        geom=$(hyprctl activewindow -j | \
            python3 -c "import sys,json; w=json.load(sys.stdin); print('{},{} {}x{}'.format(w['at'][0],w['at'][1],w['size'][0],w['size'][1]))" 2>/dev/null)
        if [ -n "$geom" ]; then
            grim -g "$geom" - | ${wl_copy_cmd}
        else
            grim - | ${wl_copy_cmd}
        fi ;;

    "full screen (copy)")
        grim - | ${wl_copy_cmd} ;;

    "copy selected image to text")
        tmpfile=$(mktemp /tmp/ocr-XXXXXX.png)
        grim -g "$(slurp)" "$tmpfile" && \
        tesseract "$tmpfile" - -l eng | ${ocr_cmd}
        rm -f "$tmpfile" ;;
esac
